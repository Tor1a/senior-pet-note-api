# 시니어펫 노트 개발 환경변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 바꾸세요. .env 는 커밋하지 않습니다.

# docker-compose 의 PostgreSQL 비밀번호 (개발용)
POSTGRES_PASSWORD=change-me-local-only

# 백엔드 JWT 서명 비밀키 (HS256, 32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# 서비스 기준 시간대(기록 날짜 새벽 4시 규칙·알림 발송 시각). 기본 Asia/Seoul. 틀린 값이면 서버가 시작되지 않음
APP_ZONE=Asia/Seoul

# 투약 알림 FCM 발송 (기본: 끔 → 실제 발송 없이 로그만 남김)
# 켜려면 FCM_ENABLED=true 와 서비스 계정 JSON 의 base64 값을 함께 넣습니다(예: base64 -i key.json | tr -d '\n').
# 서비스 계정 키는 비밀값입니다. 키 파일을 저장소에 두거나 커밋하지 마세요. Firebase 키 발급은 대표님 승인 필요.
FCM_ENABLED=false
FCM_CREDENTIALS_BASE64=
